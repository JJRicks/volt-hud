<?xml version="1.0" encoding="UTF-8"?>
<!-- Volt HUD panel for After Effects (CEP 12). Window > Extensions > Volt HUD.
     ExtensionBundleVersion is set by tools/make-zxp.sh (plain X.Y.Z); the Mac app expects this bundle id. -->
<ExtensionManifest Version="12.0" ExtensionBundleId="com.jjricks.volthud" ExtensionBundleVersion="0.1.8"
  ExtensionBundleName="Volt HUD" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.jjricks.volthud.panel" Version="0.1.8"/>
    <Extension Id="com.jjricks.volthud.engine" Version="0.1.8"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[25.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="12.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.jjricks.volthud.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./jsx/build-comp.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Volt HUD</Menu>
          <Geometry>
            <Size><Height>820</Height><Width>380</Width></Size>
            <MinSize><Height>400</Height><Width>300</Width></MinSize>
            <MaxSize><Height>3000</Height><Width>1200</Width></MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.jjricks.volthud.engine">
      <DispatchInfo>
        <Resources>
          <MainPath>./engine.html</MainPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI><Type>Custom</Type><Geometry><Size><Height>100</Height><Width>100</Width></Size></Geometry></UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
